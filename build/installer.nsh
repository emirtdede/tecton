; Tecton installer customisation.
;
; The very first screen is the language picker: 73 languages, preselected from
; the Windows display language (exact regional match first, then the primary
; language), English when nothing matches. The selected code is written to HKCU
; so the app opens in it on first run.
;
; `installer-languages.nsh` is generated by `npm run installer:langs`; never
; edit it by hand.

!include "nsDialogs.nsh"
!include "WinMessages.nsh"
!include "LogicLib.nsh"
!include "installer-languages.nsh"

Var TectonLangDialog
Var TectonLangCombo
Var TectonLangIndex
Var TectonLanguage
Var TectonHeaderTitle
Var TectonHeaderText
Var TectonLangLabel

!macro customWelcomePage
  Page custom TectonLanguagePageCreate TectonLanguagePageLeave

  Function TectonLanguagePageCreate
    ; Keep the existing language on an in-place update; only a fresh install
    ; asks. Silent installs skip pages altogether.
    ${If} ${isUpdated}
      Abort
    ${EndIf}

    ; Resolve the Windows language first so the header, the label and the
    ; preselected row are all in the user's language from the first frame.
    !insertmacro TECTON_LANG_DEFAULT
    !insertmacro TECTON_LANG_HEADER
    !insertmacro MUI_HEADER_TEXT "$TectonHeaderTitle" "$TectonHeaderText"

    nsDialogs::Create 1018
    Pop $TectonLangDialog
    ${If} $TectonLangDialog == error
      Abort
    ${EndIf}

    ${NSD_CreateLabel} 0 0 100% 24u "$TectonLangLabel"
    Pop $0

    ${NSD_CreateCombobox} 0 28u 100% 132u ""
    Pop $TectonLangCombo
    !insertmacro TECTON_LANG_ADD

    SendMessage $TectonLangCombo ${CB_SETCURSEL} $TectonLangIndex 0
    ${NSD_SetFocus} $TectonLangCombo

    nsDialogs::Show
  FunctionEnd

  Function TectonLanguagePageLeave
    SendMessage $TectonLangCombo ${CB_GETCURSEL} 0 0 $TectonLangIndex

    ; English until a translated language is selected, so the wizard never
    ; renders an empty page.
    !insertmacro TECTON_LANG_APPLY

    WriteRegStr HKCU "Software\Tecton" "InstallerLanguage" "$TectonLanguage"
  FunctionEnd
!macroend

; ---------------------------------------------------------------------------
; Uninstaller
;
; The uninstaller is the one place a user can lose data without noticing, so it
; asks explicitly. The default is to keep everything: reinstalling later then
; finds the same sites, personnel and cash records.
; ---------------------------------------------------------------------------

Var DeleteUserDataFlag
Var TectonUnDataDialog
Var TectonUnDataCheckbox
Var TectonUninstallLanguage
Var TectonUnDataTitle
Var TectonUnDataInfo
Var TectonUnDataCheck
Var TectonUnDataHint

!macro customUnInit
  StrCpy $DeleteUserDataFlag 0

  ; The installer saved the chosen code under HKCU. A per-machine install may
  ; have written it under HKLM through SHCTX, so both are checked before the
  ; English fallback.
  ClearErrors
  ReadRegStr $TectonUninstallLanguage HKCU "Software\Tecton" "InstallerLanguage"
  ${If} $TectonUninstallLanguage == ""
    ReadRegStr $TectonUninstallLanguage SHCTX "Software\Tecton" "InstallerLanguage"
  ${EndIf}
  ${If} $TectonUninstallLanguage == ""
    StrCpy $TectonUninstallLanguage "en"
  ${EndIf}

  !insertmacro TECTON_UNINSTALL_APPLY
!macroend

!macro customUnWelcomePage
  !insertmacro MUI_UNPAGE_WELCOME
  UninstPage custom un.TectonUserDataPageCreate un.TectonUserDataPageLeave

  Function un.TectonUserDataPageCreate
    !insertmacro TECTON_UNINSTALL_TEXT
    !insertmacro MUI_HEADER_TEXT "$TectonUnDataTitle" "$TectonUnDataInfo"

    nsDialogs::Create 1018
    Pop $TectonUnDataDialog
    ${If} $TectonUnDataDialog == error
      Abort
    ${EndIf}

    ${NSD_CreateCheckbox} 0 6u 100% 20u "$TectonUnDataCheck"
    Pop $TectonUnDataCheckbox
    ${If} $DeleteUserDataFlag == 1
      ${NSD_Check} $TectonUnDataCheckbox
    ${EndIf}

    ${NSD_CreateLabel} 14u 32u 92% 34u "$TectonUnDataHint"
    Pop $0

    nsDialogs::Show
  FunctionEnd

  Function un.TectonUserDataPageLeave
    ${NSD_GetState} $TectonUnDataCheckbox $DeleteUserDataFlag
  FunctionEnd
!macroend

!macro customUnInstall
  ; Windows 11 Settings > Installed apps reads these keys. Publisher, support
  ; and update links must point at Tecton, not at the default electron value.
  WriteRegStr SHCTX "${UNINSTALL_REGISTRY_KEY}" "Publisher" "Emir Tarik Dede"
  WriteRegStr SHCTX "${UNINSTALL_REGISTRY_KEY}" "URLInfoAbout" "https://github.com/emirtdede"
  WriteRegStr SHCTX "${UNINSTALL_REGISTRY_KEY}" "URLUpdateInfo" "https://github.com/emirtdede/tecton/releases"
  WriteRegStr SHCTX "${UNINSTALL_REGISTRY_KEY}" "HelpLink" "https://github.com/emirtdede/tecton/issues"
  WriteRegStr SHCTX "${UNINSTALL_REGISTRY_KEY}" "Comments" "Tecton - Emir Tarik Dede"
  WriteRegDWORD SHCTX "${UNINSTALL_REGISTRY_KEY}" "NoModify" 1
  WriteRegDWORD SHCTX "${UNINSTALL_REGISTRY_KEY}" "NoRepair" 1

  ${If} $DeleteUserDataFlag == 1
    ; Electron keeps user data in Roaming and caches in Local. Both spellings
    ; are removed because the folder name follows package.json (lower case) on
    ; some builds and productName (capitalised) on others.
    RMDir /r "$APPDATA\Tecton"
    RMDir /r "$APPDATA\tecton"
    RMDir /r "$LOCALAPPDATA\Tecton"
    RMDir /r "$LOCALAPPDATA\tecton"
    DeleteRegKey HKCU "Software\Tecton"
    DeleteRegKey SHCTX "Software\Tecton"
  ${EndIf}
!macroend

; ---------------------------------------------------------------------------
; Installer finishing touches
; ---------------------------------------------------------------------------

!macro customInstall
  ; Point Explorer at the small tray icon instead of the 200 MB executable so
  ; the shortcut and Add/Remove Programs icon paint immediately.
  ${If} ${FileExists} "$INSTDIR\resources\tecton_assets\tecton-tray-dark.ico"
    WriteRegStr SHCTX "${UNINSTALL_REGISTRY_KEY}" "DisplayIcon" "$INSTDIR\resources\tecton_assets\tecton-tray-dark.ico,0"
  ${EndIf}

  WriteRegStr SHCTX "${UNINSTALL_REGISTRY_KEY}" "Publisher" "Emir Tarik Dede"
  WriteRegStr SHCTX "${UNINSTALL_REGISTRY_KEY}" "URLInfoAbout" "https://github.com/emirtdede"
  WriteRegStr SHCTX "${UNINSTALL_REGISTRY_KEY}" "URLUpdateInfo" "https://github.com/emirtdede/tecton/releases"
  WriteRegStr SHCTX "${UNINSTALL_REGISTRY_KEY}" "HelpLink" "https://github.com/emirtdede/tecton/issues"
  WriteRegStr SHCTX "${UNINSTALL_REGISTRY_KEY}" "Comments" "Tecton - Emir Tarik Dede"
!macroend
