{
  "name": "tecton",
  "version": "1.0.0",
  "description": "Tecton - Modern construction site operating system for Windows",
  "author": {
    "name": "Emir Tarık Dede"
  },
  "main": "src/main/index.js",
  "bin": {
    "tecton": "src/cli/tecton.js",
    "tecton-mcp": "src/mcp/server.js"
  },
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "build:react": "vite build",
    "build:electron": "npm run installer:langs && electron-builder --config electron-builder.config.cjs",
    "build": "npm run build:react && npm run build:electron",
    "brand": "electron scripts/generateBrandAssets.js",
    "installer:langs": "node scripts/generateInstallerLanguages.js",
    "mcp": "node src/mcp/server.js",
    "cli": "node src/cli/tecton.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "quality": "node scripts/quality-gate.js",
    "i18n:check": "node scripts/check-i18n.js",
    "style:check": "node scripts/check-style.js",
    "style:fix": "node scripts/check-style.js --fix",
    "seed": "node scripts/seedDatabase.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "date-fns": "^4.4.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "express": "^5.2.1",
    "i18next": "^26.3.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.368.0",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.8",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "chalk": "^4.1.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "rcedit": "^5.0.2",
    "vite": "^5.2.8",
    "vitest": "^4.1.8",
    "wait-on": "^7.2.0"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emirtdede/tecton.git"
  },
  "homepage": "https://github.com/emirtdede/tecton#readme",
  "bugs": {
    "url": "https://github.com/emirtdede/tecton/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
