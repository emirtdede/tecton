{
  "name": "tecton",
  "version": "1.0.0",
  "description": "Tecton - Next Generation Construction Site Operating System",
  "author": "Emir Tarık Dede",
  "main": "src/main/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "build:react": "vite build",
    "build:electron": "electron-builder",
    "build": "npm run build:react && npm run build:electron",
    "test": "vitest run",
    "flip-fuses": "npx @electron/fuses@2.0.0 read --app ./release/win-unpacked/Tecton.exe",
    "seed": "node scripts/seedDatabase.js"
  },
  "build": {
    "appId": "com.tecton.app",
    "productName": "Tecton",
    "icon": "tecton_assets/tecton_dark.ico",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "tecton_assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "tecton_assets/tecton_dark.ico",
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "shortcutName": "Tecton",
      "uninstallDisplayName": "Tecton",
      "installerIcon": "tecton_assets/tecton_dark.ico",
      "uninstallerIcon": "tecton_assets/tecton_dark.ico",
      "installerHeaderIcon": "tecton_assets/tecton_dark.ico"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "clsx": "^2.1.0",
    "date-fns": "^4.4.0",
    "electron-log": "^5.4.4",
    "express": "^5.2.1",
    "file-type": "22.1.1",
    "i18next": "^26.3.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.368.0",
    "multer": "2.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.22.3",
    "tailwind-merge": "^2.2.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.19",
    "chalk": "^4.1.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3",
    "jsdom": "^30.1.2",
    "playwright": "^1.60.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.8",
    "vitest": "^4.1.8",
    "wait-on": "^7.2.0"
  }
}
